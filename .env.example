# Порт сервера
PORT=5000

# Інтервал автоматичного сканування у хвилинах
SCAN_INTERVAL_MINUTES=30

# Telegram Bot (для отримання миттєвих сповіщень про знайдені вакансії)
# Отримайте токен у @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш Chat ID (отримайте у @userinfobot)
TELEGRAM_CHAT_ID=

# Опціонально: Google Custom Search API
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Опціонально: SerpAPI (Google Search)
SERPAPI_KEY=

